{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMealRecipesTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-1:*:table/MealRecipesTable",
        "arn:aws:dynamodb:ap-southeast-1:*:table/MealRecipesTable/index/*"
      ]
    },
    {
      "Sid": "WriteLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:*:log-group:/aws/lambda/*:*"
    }
  ]
}
